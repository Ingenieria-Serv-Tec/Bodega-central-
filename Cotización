const PHOTOS = {"2921007": "data:image/jpeg;base64,", "2921009": "data:image/jpeg;base64,", "2921010": "data:image/jpeg;base64,", "2921011": "data:image/jpeg;base64,", "2921171": "data:image/jpeg;base64,"};
const EST = {stock:["En bodega","b-stock","var(--ok)"],agotado:["Agotado","b-agotado","var(--no)"],transito:["En tránsito","b-transito","var(--tr)"],cotizacion:["En cotización","b-cotizacion","var(--co)"]};
const norm = s => (s||"").toString().toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"");
function prep(){ DATA.forEach((d,i) => { d._i=i; d._s = norm([d.cb,d.it,d.de,d.ma,d.mo,d.np,d.eq,d.cat,d.ti].join(" ")); }); }
prep();
let cat="", av="", cr="", q="";
const $=id=>document.getElementById(id);
function esc(s){return (s||"").toString().replace(/&/g,"&amp;").replace(/</g,"&lt;")}
function fsrc(d){return d.cb ? (PHOTOS[d.cb] || null) : null}
function title(s){return s.charAt(0)+s.slice(1).toLowerCase()}
function money(v){return "$"+v.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g,",")}

const EMO = {"REFRIGERACIÓN":"❄️","HORNOS":"🔥","ELECTRICIDAD":"⚡","CLIMATIZACIÓN":"🌬️","BALANZAS":"⚖️","PLOMERÍA":"🚿","REBANADORAS":"🔪","REPUESTOS":"🔩","SISTEMAS DE TRANSMICIÓN":"⚙️","SISTEMAS DE TRANSMISIÓN":"⚙️","ILUMINACIÓN":"💡","RODAMIENTOS":"🛞","ELECTRONICA":"🔌","ELECTRÓNICA":"🔌","SOLDADURA":"⚒️","EQUIPO DE SERVICIO":"🛠️","EQUIPO EN INVENTARIO":"🗃️","INSUMOS DE MANTENIMIENTO":"🧴","INSUMOS DE PRODUCCIÓN":"🏭","EQUIPO DE PRODUCCIÓN":"🏭","ELEMENTOS DE SUJECIÓN":"🔩"};
function emo(c){return EMO[c]||"📦"}
function buildChips(){
  const cats = {};
  DATA.forEach(d => { if(d.cat) cats[d.cat]=(cats[d.cat]||0)+1; });
  cat = "";
  $("chips").innerHTML = '<option value="">Todos</option>' +
    Object.entries(cats).sort((a,b)=>b[1]-a[1])
      .map(([c,n])=>`<option value="${esc(c)}">${emo(c)} ${esc(title(c))} · ${n}</option>`).join("");
}
buildChips();

function render(){
  const terms = norm(q).split(/\s+/).filter(Boolean);
  const res = DATA.filter(d =>
    (!cat || d.cat===cat) &&
    (!av || (av==="stock" ? d.es==="stock" : d.es!=="stock")) &&
    (!cr || d.cr===cr) &&
    terms.every(t => d._s.includes(t))
  );
  $("count").textContent = res.length + (res.length===1?" repuesto":" repuestos");
  if(!res.length){
    $("list").innerHTML = '<div class="empty"><b>Sin resultados</b>Prueba con otro filtro, el código de barra o parte de la descripción.</div>';
    return;
  }
  $("list").innerHTML = res.map(d => {
    const [lbl,cls] = EST[d.es];
    const qty = d.es==="stock" ? ` · ${d.inv} und` : "";
    const psrc = fsrc(d);
    const img = psrc ? `<img src="${psrc}" loading="lazy" alt="">` : "";
    const crit = d.cr==="CRÍTICO" ? '<span class="tag-cr">CRÍTICO</span>' : "";
    const lo = d.lo ? '<span class="tag-lo">⚠ Bajo stock</span>' : "";
    const precio = d.pu ? `<span class="precio">${money(d.pu)}</span>` : "";
    return `<div class="card st-${d.es}" data-i="${d._i}">
      <button class="addbtn" data-add="${d._i}" aria-label="Agregar a cotización">+</button>
      <div class="ph"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#333" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.7"/><path d="M21 15l-5-5-9 9"/></svg>${img}</div>
      <div class="info">
        <span class="badge ${cls}">${lbl}${qty}</span>${crit}${lo}
        <div class="de">${esc(d.de)}</div>
        <div class="mm">${d.ma?`<b>${esc(d.ma)}</b>`:""}${d.mo?` · ${esc(d.mo)}`:""}${d.np?` · N/P ${esc(d.np)}`:""}</div>
        <div class="meta">
          ${d.cb?`<span class="cb">${d.cb}</span>`:""}
          ${d.eq?`<span>${emo(d.cat)} ${esc(d.eq)}</span>`:""}
          ${precio}
          ${d.ti?`<span>📍 ${esc(d.ti)}</span>`:""}
        </div>
      </div>
    </div>`;
  }).join("");
}

function field(k,v,mono){ return v ? `<div class="f"><div class="k">${k}</div><div class="v${mono?' mono':''}">${esc(v)}</div></div>` : ""; }

function openDetail(d){
  const [lbl,,color] = EST[d.es];
  const src = fsrc(d);
  $("sh-cb").textContent = d.cb ? "Código "+d.cb : "Sin código asignado";
  const pu = d.pu ? `<span class="pu">precio unitario<b>${money(d.pu)}</b></span>` : "";
  const stockTxt = d.es==="stock"
    ? `<span class="n">${d.inv}</span><span class="l"><b style="color:${color}">${lbl}</b><br>unidades disponibles${d.re?` · reorden: ${d.re}`:""}${d.lo?` · <b style="color:#A8720A">⚠ bajo stock</b>`:""}</span>${pu}`
    : `<span class="n" style="font-size:18px">${lbl.toUpperCase()}</span><span class="l">${d.es==="agotado"?"Sin unidades en bodega":d.es==="transito"?"Pedido en camino a bodega":"En proceso de cotización"}</span>${pu}`;
  const ph = src
    ? `<div class="bigph"><img id="dimg" src="${src}" alt="Foto del repuesto"></div><div class="phhint">Toca la foto para ampliarla</div>`
    : `<div class="bigph"><div class="noimg"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#333" stroke-width="1.4"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.7"/><path d="M21 15l-5-5-9 9"/></svg>Foto pendiente</div></div>`;
  $("sh-body").innerHTML = `
    ${ph}
    <div class="sh-title">${esc(d.de)}${d.cr==="CRÍTICO"?' <span class="tag-cr">CRÍTICO</span>':''}</div>
    <div class="sh-sub">${d.ma?`<b>${esc(d.ma)}</b>`:""}${d.mo?` · ${esc(d.mo)}`:""}</div>
    <div class="stockline" style="--st:${color}">${stockTxt}</div>
    <div style="display:flex;gap:8px;margin-bottom:14px">
      <div class="qty" style="background:#fff;border:1px solid var(--line);border-radius:10px;padding:3px 4px">
        <button id="dminus">−</button><span id="dqty">1</span><button id="dplus">+</button>
      </div>
      <button id="dadd" style="flex:1;border:none;border-radius:10px;background:var(--accent);color:#fff;font-size:14px;font-weight:700;cursor:pointer">🛒 Agregar a cotización</button>
    </div>
    <div class="fields">
      ${field("Categoría", d.cat ? emo(d.cat)+" "+title(d.cat) : "")}
      ${field("Equipo", d.eq)}
      ${field("N° de parte", d.np, true)}
      ${field("Ítem", d.it, true)}
      ${field("Proveedor", d.pr)}
      ${field("Tiendas", d.ti)}
      ${field("Fase", d.fa)}
      ${field("Criticidad", d.cr)}
    </div>`;
  $("overlay").classList.add("open");
  $("sheet").classList.add("open");
  document.body.classList.add("noscroll");
  const dimg = $("dimg");
  if(dimg) dimg.onclick = () => { $("zoomimg").src = dimg.src; $("zoom").classList.add("open"); };
  let dq = 1;
  const upd = () => $("dqty").textContent = dq;
  $("dminus").onclick = () => { if(dq>1){dq--;upd();} };
  $("dplus").onclick = () => { dq++; upd(); };
  $("dadd").onclick = () => { cartAdd(d._i, dq); closeDetail(); };
}

function closeDetail(){
  $("overlay").classList.remove("open");
  $("sheet").classList.remove("open");
  document.body.classList.remove("noscroll");
}

$("list").addEventListener("click", e => {
  const ab = e.target.closest(".addbtn");
  if(ab){ cartAdd(+ab.dataset.add, 1); return; }
  const c = e.target.closest(".card");
  if(c) openDetail(DATA[+c.dataset.i]);
});
$("close").onclick = closeDetail;
$("overlay").onclick = () => { closeDetail(); cartClose(); adminClose(); };
$("zoom").onclick = () => $("zoom").classList.remove("open");
document.addEventListener("keydown", e => { if(e.key==="Escape"){ $("zoom").classList.remove("open"); closeDetail(); cartClose(); adminClose(); } });

$("q").addEventListener("input", e => { q=e.target.value; $("clear").style.display=q?"block":"none"; render(); });
$("clear").onclick = () => { q=""; $("q").value=""; $("clear").style.display="none"; render(); $("q").focus(); };
$("chips").addEventListener("change", e => {
  cat = e.target.value; render();
});
$("avail").addEventListener("click", e => {
  const b = e.target.closest(".av"); if(!b) return;
  document.querySelectorAll("#avail .av").forEach(c=>c.classList.remove("on"));
  b.classList.add("on"); av=b.dataset.av; render();
});
$("critf").addEventListener("click", e => {
  const b = e.target.closest(".av"); if(!b) return;
  document.querySelectorAll("#critf .av").forEach(c=>c.classList.remove("on"));
  b.classList.add("on"); cr=b.dataset.cr; render();
});

// ============ COTIZACIÓN (carrito) ============
let CART = {};
try { CART = JSON.parse(localStorage.getItem("cotizacion")||"{}"); } catch(e){ CART = {}; }
function cartSave(){ try{ localStorage.setItem("cotizacion", JSON.stringify(CART)); }catch(e){} }
function cartCount(){ return Object.values(CART).reduce((a,b)=>a+b,0); }
function cartBadge(){
  const n = cartCount();
  const b = $("cartbadge");
  b.textContent = n;
  b.classList.toggle("zero", n===0);
}
function toast(msg){
  const t = $("toast");
  t.textContent = msg;
  t.classList.add("show");
  clearTimeout(t._h);
  t._h = setTimeout(()=>t.classList.remove("show"), 1600);
}
function cartAdd(i, qty){
  CART[i] = (CART[i]||0) + qty;
  cartSave(); cartBadge();
  toast("✓ Agregado: " + (DATA[i].de.length>34 ? DATA[i].de.slice(0,34)+"…" : DATA[i].de));
}
function cartRender(){
  const keys = Object.keys(CART);
  if(!keys.length){
    $("cartitems").innerHTML = '<div class="cempty"><b>Tu cotización está vacía</b>Usa el botón + de cualquier repuesto para agregarlo.</div>';
    $("cartfoot").style.display = "none";
    return;
  }
