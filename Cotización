        const rows = sheetRowsA(XLSX.read(new Uint8Array(r.result),{type:"array"}), "LISTA DE CODIGOS");
        const h = findHeaderA(rows, "BARRA");
        if(h<0) throw new Error("No encontré la columna de código de barra");
        const cm = colMapA(rows[h], {
          item:["ITEM"], cb:["COD. BARRA","CODIGO DE BARRA"], nombre:["NOMBRE","ITEMNOMBRE"],
          cat:["CATEGORIA"], grupo:["GRUPO"], prov:["PROVEEDOR","PROVEEDORNOMB"],
          inv:["INVENTARIO"], reo:["PUNTO DE REORDEN","REORDEN"], pu:["PRECIO"]});
        if(cm.cb===undefined||cm.nombre===undefined||cm.inv===undefined) throw new Error("Faltan columnas (código, nombre o inventario)");
        aBod = rows.slice(h+1).filter(r2 => anorm(r2[cm.nombre])).map(r2 => ({
          it: aint(r2[cm.item]), cb: aint(r2[cm.cb]), de: anorm(r2[cm.nombre]),
          cat: aflat(r2[cm.cat]) || "OTROS", eq: anorm(r2[cm.grupo]), pr: anorm(r2[cm.prov]),
          inv: aint(r2[cm.inv]), re: cm.reo!==undefined ? aint(r2[cm.reo]) : 0,
          pu: cm.pu!==undefined ? (Math.round((parseFloat(r2[cm.pu])||0)*100)/100) : 0 }));
        $("am-bod").innerHTML = `<span class="aok">✓ ${aBod.length} repuestos leídos</span>`;
        $("aapply").disabled = false;
      }catch(err){ $("am-bod").innerHTML = `<span class="aerr">✗ ${err.message}</span>`; }
    };
    r.readAsArrayBuffer(file);
