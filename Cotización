const aflat = s => String(s??"").replace(/\s+/g," ").trim().toUpperCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"");
const anorm = s => { const t = String(s??"").replace(/\s+/g," ").trim(); return (t==="null"||t==="undefined")?"":t; };
const aint = v => { const n = parseFloat(v); return isNaN(n) ? 0 : Math.round(n); };

function loadXLSX(cb, msgId){
  if(window.XLSX) return cb();
  $(msgId).innerHTML = 'Cargando lector de Excel…';
  const s = document.createElement("script");
  s.src = "https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js";
  s.onload = cb;
  s.onerror = () => $(msgId).innerHTML = '<span class="aerr">✗ Se necesita conexión a internet para leer Excel (solo la primera vez).</span>';
  document.head.appendChild(s);
}
function sheetRowsA(wb, prefer){
  const name = wb.SheetNames.find(n => aflat(n)===aflat(prefer)) || wb.SheetNames[0];
  return XLSX.utils.sheet_to_json(wb.Sheets[name], {header:1, defval:null});
}
function findHeaderA(rows, must){
  for(let i=0;i<Math.min(rows.length,10);i++){
    if((rows[i]||[]).some(c => aflat(c).includes(must))) return i;
  }
  return -1;
}
function colMapA(hrow, aliases){
  const map = {};
  hrow.forEach((h,idx) => {
    const f = aflat(h);
    for(const [k,names] of Object.entries(aliases)){
      if(map[k]===undefined && names.some(n => f===n)) map[k]=idx;
    }
  });
  return map;
}
$("a-bod").addEventListener("change", e => {
