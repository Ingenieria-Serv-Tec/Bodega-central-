        const h = findHeaderA(rows, "CODIGO DE BARRA");
        if(h<0) throw new Error("No encontré los encabezados esperados");
        const cm = colMapA(rows[h], {
          item:["ITEM"], cb:["CODIGO DE BARRA"], cat:["CATEGORIA"], eq:["EQUIPO"], de:["DESCRIPCION"],
          ma:["MARCA"], mo:["MODELO"], np:["NUMERO DE PARTE"], pr:["PROVEEDOR"],
          inv:["INVENTARIO"], re:["REORDEN"], fa:["FASE"], ti:["TIENDA"], cr:["CRITICIDAD"]});
        aCrit = rows.slice(h+1).filter(r2 => anorm(r2[cm.de])).map(r2 => {
          const itemRaw = aflat(r2[cm.item]);
          let np = anorm(r2[cm.np]); if(np==="PD") np="";
          const inv = aint(r2[cm.inv]);
          let es = "agotado";
          if(inv>0) es="stock"; else if(itemRaw==="EN TRANSITO") es="transito"; else if(itemRaw==="COTIZACION") es="cotizacion";
          return { it: aint(r2[cm.item])>0?String(aint(r2[cm.item])):"", cb: aint(r2[cm.cb]),
            cat: aflat(r2[cm.cat]), eq: anorm(r2[cm.eq]), de: anorm(r2[cm.de]), ma: anorm(r2[cm.ma]),
            mo: anorm(r2[cm.mo]), np, pr: anorm(r2[cm.pr]), inv, re: aint(r2[cm.re]),
            fa: anorm(r2[cm.fa]), ti: anorm(r2[cm.ti]), cr: aflat(r2[cm.cr]).replace("CRITICO","CRÍTICO"), es, pu: 0 };
        });
        $("am-crit").innerHTML = `<span class="aok">✓ ${aCrit.length} repuestos críticos leídos</span>`;
      }catch(err){ $("am-crit").innerHTML = `<span class="aerr">✗ ${err.message}</span>`; }
    };
    r.readAsArrayBuffer(file);
  }, "am-crit");
});
