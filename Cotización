$("aapply").onclick = () => {
  try{
    // 1) Fuente de enriquecimiento: excel de críticos o los datos actuales del catálogo
    let critByCb = {}, critExtra = [];
    if(aCrit){
      aCrit.forEach(c => { if(c.cb>0) critByCb[c.cb]=c; });
      critExtra = aCrit;
    } else {
      DATA.forEach(c => { if(c.cb && (c.ma||c.mo||c.cr||c.np||c.ti)) critByCb[c.cb]=c; });
      critExtra = DATA.filter(c => c.es==="transito" || c.es==="cotizacion" || !c.cb);
    }
    // 2) Consolidar (si no cargaron bodega nueva, se mantienen los datos actuales)
    let out;
    if(aBod){
      const usados = new Set(), bodCbs = new Set();
      out = aBod.map(r => {
        const c = critByCb[r.cb];
        if(r.cb>0) bodCbs.add(r.cb);
        if(c) usados.add(r.cb);
        return { it: r.it>0?String(r.it):"", cb: r.cb>0?r.cb:"",
          cat: r.cat, eq: (c&&c.eq)?c.eq:r.eq, de: (c&&c.de)?c.de:r.de,
          ma: c?c.ma||"":"", mo: c?c.mo||"":"", np: c?c.np||"":"",
          pr: (c&&c.pr)?c.pr:r.pr, inv: r.inv, re: r.re>0?r.re:(c?c.re||0:0),
          fa: c?c.fa||"":"", ti: c?c.ti||"":"", cr: c?c.cr||"":"",
          es: r.inv>0?"stock":"agotado", pu: r.pu };
      });
      critExtra.forEach(c => { if(!(c.cb && (usados.has(c.cb)||bodCbs.has(c.cb)))) out.push({...c}); });
    } else {
      out = DATA.map(d => ({...d}));
    }
    out.forEach(i => { i.lo = (i.inv>0 && i.re>0 && i.inv<=i.re) ? 1 : 0; });
    // 3) Remapear la cotización en curso (por código de barra)
    const cartByCb = {};
    Object.keys(CART).forEach(k => { const d = DATA[+k]; if(d && d.cb) cartByCb[d.cb] = CART[k]; });
    // 4) Aplicar datos y fotos
    DATA.splice(0, DATA.length, ...out);
    aDel.forEach(c => delete PHOTOS[c]);
    aNew.forEach(f => { if(f.code) PHOTOS[f.code] = f.durl; });
    aNew = []; aDel = new Set();
    prep();
    CART = {};
    DATA.forEach(d => { if(d.cb && cartByCb[d.cb]) CART[d._i] = cartByCb[d.cb]; });
    cartSave(); cartBadge();
    buildChips();
    av=""; cr=""; q=""; $("q").value="";
    document.querySelectorAll("#avail .av").forEach((b,i)=>b.classList.toggle("on",i===0));
    document.querySelectorAll("#critf .av").forEach((b,i)=>b.classList.toggle("on",i===0));
    render();
    const hoy = new Date().toLocaleDateString("es-PA",{day:"numeric",month:"long",year:"numeric"});
    document.querySelector("footer").textContent = `Actualizado: ${hoy} · ${DATA.length} repuestos · Cantidades y precios según inventario de bodega`;
    renderNewA(); renderExistA();
    $("adown").style.display = "block";
    $("aapply").disabled = true;
    $("am-gen").innerHTML = `<span class="aok">✓ Vista actualizada: ${DATA.length} repuestos, ${Object.keys(PHOTOS).length} fotos.</span> Ahora descarga el catálogo para compartirlo.`;
  }catch(err){ $("am-gen").innerHTML = `<span class="aerr">✗ ${err.message}</span>`; }
};
$("adown").onclick = () => {
  const clean = DATA.map(d => { const c = {...d}; delete c._i; delete c._s; return c; });
  const bytes = Uint8Array.from(atob(TPL_B64), ch => ch.charCodeAt(0));
  let out = new TextDecoder().decode(bytes);
  const P_DATA = "__DA" + "TA__", P_FOTOS = "__PHO" + "TOS__", P_TPL = '"@TP' + 'L@"';
  out = out.split(P_DATA).join(JSON.stringify(clean));
  out = out.split(P_FOTOS).join(JSON.stringify(PHOTOS));
  out = out.split(P_TPL).join('"' + TPL_B64 + '"');
  const hoy = new Date().toLocaleDateString("es-PA",{day:"numeric",month:"long",year:"numeric"});
  out = out.replace(/Actualizado: [^·<]*· \d+ repuestos/, `Actualizado: ${hoy} · ${clean.length} repuestos`);
  const blob = new Blob([out], {type:"text/html"});
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "catalogo_repuestos_bodega.html";
  a.click();
  URL.revokeObjectURL(a.href);
  $("am-gen").innerHTML = '<span class="aok">✓ Descargado.</span> Compártelo con los encargados (WhatsApp, correo o carpeta compartida).';
};

</script>
</body>
